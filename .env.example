# Copy to .env before deployment. Change the admin password immediately.
PORT=3000
ADMIN_EMAIL=admin@qinashgebeya.local
ADMIN_PASSWORD=ChangeThisToALongUniquePassword
# Optional; leave blank locally. On hosting, set this to your HTTPS domain.
PUBLIC_URL=

# Optional outbound email. Without SMTP, registration links are printed to
# the server terminal and shown in the local registration response.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
